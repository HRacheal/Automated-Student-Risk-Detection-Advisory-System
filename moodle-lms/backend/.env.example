# Copy to moodle-lms/backend/.env and fill in. Never commit the real .env.

# Moodle site root (REST endpoint, login/token.php and upload.php are resolved from it)
MOODLE_URL=http://localhost:8081
# External service that per-student tokens are issued for (created by moodle-setup/setup_lms_service.php)
MOODLE_SERVICE=mycoach_lms
# Lookup-only token (service mycoach_lms_lookup): resolves student ID -> Moodle username at sign-in.
# Written by the setup script to LMS_LOOKUP_TOKEN_FILE.
MOODLE_LOOKUP_TOKEN=<token>

# Random string; keys the server-side session store
SESSION_SECRET=<long random string>
# SESSION_TTL_HOURS=8
# COOKIE_SECURE=true          # when served over HTTPS

# My Coach backend (server-to-server; same value as LMS_INTEGRATION_KEY in backend/.env)
MYCOACH_API_URL=http://127.0.0.1:8000
MYCOACH_INTEGRATION_KEY=<long random string>
# Where the "Open My Coach" button sends the student
MYCOACH_PORTAL_URL=http://localhost:3000/student

# Timezone used to display Moodle dates (the Moodle site timezone)
LMS_TIMEZONE=Africa/Nairobi

# Synthetic test accounts only: the password the setup script gave the s6900NN students.
# Used by tests/test_live_moodle.py.
TEST_STUDENT_PASSWORD=<password>
