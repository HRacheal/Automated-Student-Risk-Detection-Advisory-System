# Copy to backend/.env and fill in real values. Never commit backend/.env.

# RosarioSIS REST_API plugin endpoint (auth.php is resolved in the same folder)
ROSARIO_API_URL=http://localhost/rosariosis/plugins/REST_API/api.php
ROSARIO_API_TOKEN=<user token from RosarioSIS > School > Configuration > Plugins > REST API>

# Moodle REST web services endpoint + token (Site admin > Server > Web services)
MOODLE_API_URL=http://localhost/moodle/webservice/rest/server.php
MOODLE_API_TOKEN=<moodle web service token>

# Signing secret for advisor session tokens
JWT_SECRET=<long random string>

# PostgreSQL connection string for application data
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>

# Advisor login for the dashboard
ADVISOR_EMAIL=advisor@usiu.ac.ke
ADVISOR_NAME=Academic Advisor
ADVISOR_PASSWORD=<choose a password>

# Controlled local test data (Test Lab). Set to false to use only RosarioSIS/Moodle.
DEMO_DATA_ENABLED=true

# Optional
# EXTERNAL_TIMEOUT_SECONDS=10
# JWT_EXPIRE_HOURS=8
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Student sign-in (optional). STUDENT_ID links the account to ONE RosarioSIS student record.
STUDENT_EMAIL=student@usiu.ac.ke
STUDENT_PASSWORD=<choose a password>
STUDENT_NAME=Student
STUDENT_ID=<RosarioSIS student_id>

# Admin sign-in (optional)
ADMIN_EMAIL=admin@usiu.ac.ke
ADMIN_PASSWORD=<choose a password>
ADMIN_NAME=System Administrator

# Optional: shared key for the My Coach LMS app (moodle-lms/). The LMS backend sends it to
# GET /api/integration/lms/students/{id}/summary. Leave empty to disable that endpoint.
LMS_INTEGRATION_KEY=<long random string, same value as MYCOACH_INTEGRATION_KEY in moodle-lms/backend/.env>
